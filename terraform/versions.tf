# Remote state is intentionally unset. Before this is applied in a shared
# project, put state in a GCS bucket. Nothing here has been applied.

terraform {
  required_version = ">= 1.6.0"

  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 6.0"
    }
  }
}

provider "google" {
  project = var.project_id
  region  = var.region
}
